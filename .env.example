# 复制为 .env 后填写。不要提交 .env。
#
# 生成 JWT 密钥：
#   openssl rand -hex 32
# 生成管理员密码：
#   openssl rand -base64 32

# GitHub 用户名或组织名，必须与 GHCR 镜像 owner 一致并使用小写。
GHCR_OWNER=
IMAGE_TAG=latest

# 必填：请粘贴上方命令生成的值，禁止使用示例字符串或项目默认值。
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 生产环境安全配置
APP_ENV=production
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MAX_UPLOAD_BYTES=10485760
SQLITE_BUSY_TIMEOUT_MS=5000
SEED_INITIAL_DATA=false
RUN_LEGACY_COMPAT_MIGRATION=false
ENABLE_DOCS=false

# 默认仅监听宿主回环地址，由 Nginx/Caddy 反向代理。
BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# 宿主持久化目录。Linux 上需保证容器 UID/GID 10001 可写。
DATA_DIR=./data
UPLOADS_DIR=./uploads

# 生产 Compose 固定使用 /app/data/blog.db，避免备份/恢复错位。
# 仅直接运行 Python 时可按需导出 DATABASE_URL；本地默认使用项目根目录 blog.db。
